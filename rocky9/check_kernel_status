#!/usr/bin/env bash

current="$(uname -r)"
status=0
msg="OK - running latest kernel ($current)"

if command -v rpm >/dev/null 2>&1; then
    latest="$(rpm -q --last kernel | awk 'NR==1{sub(/^kernel-/,"",$1); print $1}')"
    next="$(basename "$(grubby --default-kernel 2>/dev/null)" | sed 's/^vmlinuz-//')"

elif command -v dpkg >/dev/null 2>&1; then
    latest="$(dpkg-query -W -f='${Package} ${Version}\n' 'linux-image-[0-9]*' 2>/dev/null \
        | awk '{print $1}' \
        | sed 's/^linux-image-//' \
        | sort -V \
        | tail -1)"

    next="$(basename "$(readlink -f /vmlinuz 2>/dev/null)" | sed 's/^vmlinuz-//')"

else
    echo "UNKNOWN - unsupported system: rpm/dpkg not found"
    exit 3
fi

if [[ -z "$latest" ]]; then
    echo "UNKNOWN - cannot detect latest installed kernel"
    exit 3
fi

if [[ -z "$next" ]]; then
    echo "UNKNOWN - cannot detect next boot kernel"
    exit 3
fi

if [[ "$next" != "$latest" ]]; then
    echo "CRITICAL - next boot kernel is $next, latest installed is $latest | running=$current next=$next latest=$latest"
    exit 2
fi

if [[ "$current" != "$latest" ]]; then
    echo "WARNING - reboot pending: running $current, latest installed $latest | running=$current next=$next latest=$latest"
    exit 1
fi

echo "$msg | running=$current next=$next latest=$latest"
exit 0