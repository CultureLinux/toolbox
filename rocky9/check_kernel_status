#!/usr/bin/env bash

current="$(uname -r)"
latest=""
next="unknown"

# Dernier kernel installé
if command -v rpm >/dev/null 2>&1; then
    latest="$(rpm -q --last kernel 2>/dev/null | awk 'NR==1{sub(/^kernel-/,"",$1); print $1}')"

elif command -v dpkg-query >/dev/null 2>&1; then
    latest="$(dpkg-query -W -f='${Package}\n' 'linux-image-[0-9]*' 2>/dev/null \
        | sed 's/^linux-image-//' \
        | sort -V \
        | tail -1)"

else
    echo "UNKNOWN - unsupported system: rpm/dpkg not found"
    exit 3
fi

# Kernel de prochain boot, méthode lisible sans root
for link in /vmlinuz /boot/vmlinuz; do
    target="$(readlink -f "$link" 2>/dev/null || true)"

    if [[ "$target" == */vmlinuz-* ]]; then
        next="$(basename "$target" | sed 's/^vmlinuz-//')"
        break
    fi
done

if [[ -z "$latest" ]]; then
    echo "UNKNOWN - cannot detect latest installed kernel"
    exit 3
fi

if [[ "$next" != "unknown" && "$next" != "$latest" ]]; then
    echo "CRITICAL - next boot kernel is $next, latest installed is $latest | running=$current next=$next latest=$latest"
    exit 2
fi

if [[ "$current" != "$latest" ]]; then
    echo "WARNING - reboot pending: running $current, latest installed $latest | running=$current next=$next latest=$latest"
    exit 1
fi

echo "OK - running latest kernel ($current) | running=$current next=$next latest=$latest"
exit 0